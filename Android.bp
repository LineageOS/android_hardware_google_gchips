soong_namespace {
    imports: [
        "hardware/google/graphics/common",
        "hardware/google/gchips/gralloc4",
    ]
}

package {
    default_applicable_licenses: [
        "Android-Apache-2.0",
        "hardware_google_gchips_license",
    ],
}

// See: http://go/android-license-faq
license {
    name: "hardware_google_gchips_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

cc_library_headers {
    name: "google_hal_headers",
    host_supported: true,
    header_libs: [
        "libaudio_system_headers",
        "libhardware_headers",
        "libsystem_headers",
        "libcutils_headers",
    ],
    export_header_lib_headers: [
        "libaudio_system_headers",
        "libsystem_headers",
        "libcutils_headers",
        "libhardware_headers",
    ],

    export_include_dirs: ["include"],
    proprietary: true,
}

soong_config_module_type {
    name: "arm_gchips_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "arm_gchips",
    variables: [
        "gchips_arm_uses_fimc",
        "gchips_arm_uses_gscaler",
    ],
    properties: [
        "cflags",
    ],
}

soong_config_bool_variable {
    name: "gchips_arm_uses_fimc",
}

soong_config_bool_variable {
    name: "gchips_arm_uses_gscaler",
}

arm_gchips_cc_defaults {
    name: "arm_gchips_defaults",
    soong_config_variables: {
        gchips_arm_uses_fimc: {
            cflags: [
                "-DUSES_FIMC",
            ],
        },
        gchips_arm_uses_gscaler: {
            cflags: [
                "-DUSES_GSCALER",
            ],
	    },
    },
}

subdirs = ["*"]
